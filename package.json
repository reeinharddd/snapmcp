{
  "name": "snapmcp",
  "mcpName": "io.github.reeinharddd/snapmcp",
  "version": "2.3.7",
  "description": "13-tool visual documentation MCP server for terminal, code, browser, file, Markdown, HTML, diff, PDF, batch, sequence, GIF, document, and capability workflows",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "screenshot",
    "terminal",
    "code",
    "syntax-highlighting",
    "shiki",
    "playwright",
    "capture",
    "snapmcp"
  ],
  "homepage": "https://github.com/reeinharddd/snapmcp#readme",
  "bugs": {
    "url": "https://github.com/reeinharddd/snapmcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeinharddd/snapmcp.git"
  },
  "license": "MIT",
  "author": "reeinharddd",
  "type": "module",
  "bin": {
    "snapmcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist/",
    "scripts/",
    "brand/",
    "llms.txt",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "setup": "node scripts/setup.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "docx": "9.15.3",
    "fast-png": "8.0.0",
    "gifenc": "1.0.3",
    "jsonc-parser": "3.3.1",
    "marked": "18.2.0",
    "playwright": "1.65.0",
    "pptxgenjs": "4.0.1",
    "shiki": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.17",
    "image-size": "2.1.0",
    "ip-address": "10.7.6",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "zod": "4.6.7"
  }
}
