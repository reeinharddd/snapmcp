{
  "name": "snapmcp",
  "description": "Visual documentation MCP server for agents: terminal output, Shiki-highlighted code for 300+ languages, HTTP(S) screenshots and PDFs, Markdown, HTML, diffs, GIFs, and captioned documents. Exactly 13 tools apply bounded inputs, deny-all file reads, output confinement, and default-on SSRF checks; capture tools return saved paths.",
  "version": "2.3.7",
  "license": "MIT",
  "repository": "https://github.com/reeinharddd/snapmcp",
  "homepage": "https://github.com/reeinharddd/snapmcp",
  "keywords": [
    "mcp",
    "visual-documentation",
    "screenshot",
    "terminal",
    "code",
    "diff",
    "pdf",
    "gif",
    "documentation",
    "playwright",
    "shiki"
  ],
  "categories": [
    "documentation-access",
    "developer-tools",
    "image-and-video-processing"
  ],
  "tools": [
    "capture_terminal",
    "capture_code",
    "capture_browser",
    "capture_file",
    "capture_markdown",
    "capture_html",
    "capture_diff",
    "capture_pdf",
    "capture_batch",
    "capture_sequence",
    "capture_gif",
    "capture_document",
    "snapmcp-hint"
  ],
  "environmentVariables": {
    "SNAPMCP_DIR": "./captures",
    "SNAPMCP_THEME": "detected terminal theme",
    "SNAPMCP_FORMAT": "png",
    "SNAPMCP_QUALITY": "90",
    "SNAPMCP_ALLOWED_PATHS": "(deny-all)",
    "SNAPMCP_SHADOW": "none",
    "SNAPMCP_BADGE": "false",
    "SNAPMCP_PADDING": "32",
    "SNAPMCP_BORDER_RADIUS": "0",
    "SNAPMCP_WINDOW_CHROME": "false",
    "SNAPMCP_CHROME_CHANNEL": "",
    "SNAPMCP_CHROME_EXECUTABLE": "",
    "SNAPMCP_CHROME_PROFILE": "(unset; experimental)",
    "SNAPMCP_SSRF_PROTECTION": "true",
    "SNAPMCP_SECURITY_CHECKS": "true"
  },
  "entrypoint": "node dist/index.js",
  "transport": "stdio",
  "runtime": {
    "node": ">=20",
    "bun": "optional"
  },
  "discovery": {
    "mcpTools": "tools/list",
    "hintTool": "snapmcp-hint",
    "mcpResource": "snapmcp://capabilities",
    "cliCatalog": "snapmcp capabilities --json",
    "cliSearch": "snapmcp search \"<intent>\" --json",
    "agentGuide": "docs/agents.md",
    "llms": "llms.txt"
  },
  "security": {
    "ssrfProtection": "default-on",
    "fileAccess": "deny-all until SNAPMCP_ALLOWED_PATHS is configured, unless broader checks are disabled",
    "outputConfinement": "SNAPMCP_DIR, including composite outputs",
    "syntheticContent": "All synthetic captures: JavaScript disabled, network resources blocked, restrictive CSP; raw HTML DOM-sanitized",
    "inputLimits": true,
    "dnsRebindingLimit": "URL captures run through a local validating proxy that resolves and pins every target, including each redirect hop; Chromium is prevented from resolving target hostnames itself. Isolating hostile targets is still recommended."
  },
  "relatedServers": [
    "microsoft/playwright-mcp",
    "ChromeDevTools/chrome-devtools-mcp",
    "mozilla/firefox-devtools-mcp",
    "HurleySk/can-see",
    "kmoulder/screen-capture-mcp"
  ]
}
