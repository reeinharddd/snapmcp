{
  "name": "snapmcp",
  "description": "All-in-one MCP server for visual captures: terminal screenshots with real theme colors, syntax-highlighted code (50+ langs, 27 themes), visual diffs, PDFs, GIFs, and markdown documents. Built-in SSRF protection, path traversal prevention, input limits. 13 typed tools with discriminated unions for complex operations.",
  "version": "2.3.3",
  "license": "MIT",
  "repository": "https://github.com/reeinharddd/snapmcp",
  "homepage": "https://github.com/reeinharddd/snapmcp",
  "keywords": ["mcp", "screenshot", "terminal", "code", "documentation", "visual", "diff", "pdf", "gif", "playwright", "shiki", "chromium"],
  "categories": ["documentation-access", "developer-tools", "image-and-video-processing"],
  "tools": [
    "capture_terminal",
    "capture_code",
    "capture_browser",
    "capture_file",
    "capture_markdown",
    "capture_html",
    "capture_diff",
    "capture_pdf",
    "capture_batch",
    "capture_gif",
    "capture_sequence",
    "capture_document",
    "snapmcp-hint"
  ],
  "environmentVariables": {
    "SNAPMCP_DIR": "./captures",
    "SNAPMCP_THEME": "auto-detected",
    "SNAPMCP_FORMAT": "png",
    "SNAPMCP_QUALITY": "90",
    "SNAPMCP_ALLOWED_PATHS": "(deny-all)",
    "SNAPMCP_SHADOW": "none",
    "SNAPMCP_BADGE": "false",
    "SNAPMCP_PADDING": "32",
    "SNAPMCP_BORDER_RADIUS": "0",
    "SNAPMCP_WINDOW_CHROME": "false",
    "SNAPMCP_CHROME_CHANNEL": "stable",
    "SNAPMCP_CHROME_PROFILE": "",
    "SNAPMCP_SSRF_PROTECTION": "true",
    "SNAPMCP_CHROME_EXECUTABLE": ""
  },
  "entrypoint": "node dist/index.js",
  "transport": "stdio",
  "security": {
    "ssrfProtection": true,
    "pathTraversalProtection": true,
    "inputLimits": true,
    "allowlistRequired": true
  },
  "relatedServers": [
    "microsoft/playwright-mcp",
    "ChromeDevTools/chrome-devtools-mcp",
    "mozilla/firefox-devtools-mcp",
    "HurleySk/can-see",
    "kmoulder/screen-capture-mcp"
  ]
}
